{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dolittle: clang-tidy",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/check.py",
        "tidy",
        "--build-dir",
        "${command:cmake.buildDirectory}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": "test"
    },
    {
      "label": "Dolittle: check formatting",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/check.py",
        "format"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": "test"
    },
    {
      "label": "Dolittle: format sources",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/check.py",
        "format",
        "--fix"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
